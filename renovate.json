{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "baseBranchPatterns": [
    "dev"
  ],
  "labels": [
    "dependencies"
  ],
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Stay on Python 3.14 until Home Assistant's dependencies ship 3.15 wheels (Pillow, numpy, ...)",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}

# Reproducible local test environment.
# HA core requires fcntl (Unix-only), so tests cannot run natively on Windows.
# This image mirrors what CI uses on GitHub Actions (Python 3.13 on Linux).
FROM python:3.12-slim

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ python3-dev git sudo \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for the Dev Container. Claude Code refuses to run with
# --dangerously-skip-permissions as root, so the VS Code extension needs a
# non-root remoteUser. CI keeps using the default (root) entrypoint below.
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

COPY requirements.txt requirements_test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements_test.txt

COPY . .

ENTRYPOINT ["pytest"]
CMD []
